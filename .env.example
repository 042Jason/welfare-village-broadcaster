# ========================================
# 복지마을 방송국 멀티에이전트 - 환경변수
# 이 파일을 .env 로 복사한 후 키를 채우세요.
# ========================================

# [필수] OpenAI - LLM (라우팅/생성)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# [필수] Tavily - 복지 정보 웹 검색 (월 1,000회 무료)
# 발급: https://app.tavily.com
TAVILY_API_KEY=tvly-...

# [선택] LangFuse - 에이전트 실행 트레이싱
# 발급: https://cloud.langfuse.com (무료 플랜 있음)
# 둘 다 없으면 트레이싱은 자동 비활성화됩니다.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# [선택] 한국어 음성 합성/인식 확장 시
# NAVER_CLOVA_CLIENT_ID=
# NAVER_CLOVA_CLIENT_SECRET=
# ELEVENLABS_API_KEY=
