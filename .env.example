# ========================================
# 복지마을 방송국 멀티에이전트 - 환경변수 템플릿
# 이 파일을 .env 로 복사한 후 키를 채우세요.
#
# ⚠️ AnySign 등으로 .env 편집이 막힌 환경에서는
#    프로젝트 루트에 API.txt 파일을 만들고 Gemini 키 한 줄만 적어두면
#    노트북이 자동으로 GOOGLE_API_KEY 환경변수에 주입합니다.
# ========================================

# ===================================================================
# [데이터 웨어하우스 - 필수] Supabase
# Dashboard: https://app.supabase.com → Project Settings → API
# 적재 노트북(01)은 SERVICE_KEY (RLS 우회), 에이전트 노트북(02)은 ANON_KEY 사용
# 사전 작업: schema.sql 을 Supabase SQL Editor에 붙여넣고 실행
# ===================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...
SUPABASE_ANON_KEY=eyJhbGciOi...

# ===================================================================
# [1차 데이터 - 필수] 공공데이터포털 (data.go.kr) — 01 노트북에서만 사용
# 두 API는 같은 data.go.kr 계정 하나로 발급, 인증키 동일.
# 발급: data.go.kr 가입 → 검색 → "활용신청" → 마이페이지 → 인증키 복사
# ===================================================================

# 행정안전부 - 대한민국 공공서비스(혜택) 정보
# https://www.data.go.kr/data/15113968/openapi.do
# Base URL: https://api.odcloud.kr/api/gov24/v3
PUBLIC_SERVICE_API_KEY=발급받은_인증키_Encoding_을_여기에

# 한국사회보장정보원 - 지자체 복지서비스
# https://www.data.go.kr/data/15108347/openapi.do
# Base URL: https://apis.data.go.kr/B554287/LocalGovernmentWelfareInformations
LOCAL_WELFARE_API_KEY=발급받은_인증키_Encoding_을_여기에

# ===================================================================
# [LLM - 필수] Google Gemini (라우팅·쉬운말 변환·방송 스크립트 생성)
# 발급: https://aistudio.google.com/app/apikey
# 무료 등급: 분당 15회, 일일 1,500회 요청 (gemini-2.5-flash 기준)
# 모델: gemini-2.5-flash (빠름·저렴) / gemini-2.5-pro (고품질)
# ===================================================================
GOOGLE_API_KEY=AIza...

# ===================================================================
# [2차 검증 - 권장] Tavily 웹 검색
# 1차 공공API 누락된 지자체 한시·신규 사업 보완용
# 발급: https://app.tavily.com (월 1,000회 무료)
# ===================================================================
TAVILY_API_KEY=tvly-...

# ===================================================================
# [LLM 대체 - 선택] OpenAI (Gemini가 막혔을 때 fallback)
# 발급: https://platform.openai.com/api-keys
# 노트북의 init_chat_model 한 줄만 "openai:gpt-4o-mini"로 바꾸면 사용 가능
# ===================================================================
OPENAI_API_KEY=sk-proj-...

# ===================================================================
# [관찰성 - 선택] LangFuse
# 발급: https://cloud.langfuse.com (EU) 또는 https://us.cloud.langfuse.com (US)
# ===================================================================
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ===================================================================
# [SMTP - 권장] 피드백 → 민원 담당자 자동 전달 (개인형 모드 escalate_email 노드)
# Gmail 사용 시:
#   1) Google 계정에 2단계 인증 활성화
#   2) https://myaccount.google.com/apppasswords 에서 "메일" 앱 비밀번호 16자 발급
#   3) 아래 항목 채우기
# 미설정 시 메일은 콘솔에 미리보기만 출력됩니다 (데모용)
# ===================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=발급받은_앱비밀번호_16자_공백없이
SMTP_FROM_NAME=복지마을 방송국
SMTP_TO=민원담당자@example.gov.kr

# ===================================================================
# [확장 - 선택] Slack 알림 (복지사 알림·고독사 위험 감지)
# 발급: https://api.slack.com/apps → Create New App
# ===================================================================
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL_ID=C...

# ===================================================================
# [확장 - 선택] TTS / STT (해커톤 시연 영상)
# ===================================================================
# NAVER_CLOVA_CLIENT_ID=
# NAVER_CLOVA_CLIENT_SECRET=
# ELEVENLABS_API_KEY=
