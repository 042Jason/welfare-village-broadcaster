# ========== Railway 환경변수 (Variables 탭에 동일하게 등록) ==========

# [필수] Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_xxx
SUPABASE_ANON_KEY=sb_publishable_xxx

# [필수] 공공데이터 (둘 다 같은 data.go.kr 키)
PUBLIC_SERVICE_API_KEY=xxx
LOCAL_WELFARE_API_KEY=xxx

# [필수] LLM (Gemini)
GOOGLE_API_KEY=AIzaxxx

# [권장] Tavily (정보 증강)
TAVILY_API_KEY=tvly-xxx

# [선택] SMTP (피드백 → 민원 담당자)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=복지마을 방송국
SMTP_TO=

# [선택] LangFuse 트레이싱
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# [선택] CORS - 프론트엔드 도메인 허용 (Vercel 배포 후 추가)
# 예: https://welfare-frontend.vercel.app,https://welfare.kr
ALLOWED_ORIGINS=*

# PORT는 Railway가 자동 설정 (수동 입력 불필요)
